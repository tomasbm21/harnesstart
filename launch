#!/usr/bin/env bash
# One entry point for Norfront Claw on Linux and Git Bash.
# Windows double-click is Launch Claw.bat. Both call the same boot.
set -euo pipefail

cd "$(cd "$(dirname "$0")" && pwd)"
ROOT="$(pwd)"
export PYTHONPATH="$ROOT/product${PYTHONPATH:+:$PYTHONPATH}"
export PATH="$HOME/.local/bin:$PATH"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Installing Python. This happens once."
  if ! command -v curl >/dev/null 2>&1; then
    echo "Python is missing, so the app cannot install it."
    exit 1
  fi
  curl -LsSf https://astral.sh/uv/install.sh | sh
  export PATH="$HOME/.local/bin:$PATH"
  uv python install 3.12
  exec uv run --python 3.12 python -m norfront_claw.boot
fi

exec python3 -m norfront_claw.boot
