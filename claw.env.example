# Norfront Claw settings. Copy to claw.env (start.sh does this for you) and fill in.
# claw.env is gitignored. After the first successful start, secret values are moved into Hermes
# inside claw-host and replaced here with __stored_in_hermes__. To change a key later, just paste the new one.

# ── Required ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# Model for every agent. Hermes's DeepSeek catalog lists: deepseek-v4-pro, deepseek-flash
CLAW_MODEL=deepseek-v4-pro

# ── Strongly recommended ─────────────────────────────────────────────────────
# Web search for the scouts: tavily | exa | firecrawl | parallel | keenable | perplexity
# Blank = Hermes's keyless free tiers (works, but 7 parallel scouts will get rate-limited).
WEB_BACKEND=
WEB_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────
# Cheaper model for scouts and builders (lean, fortress, market, infra, platform). Blank = CLAW_MODEL.
CLAW_SCOUT_MODEL=

# A different model family for lead, verifier, redteam, so judges don't share the scouts' blind spots.
# Example: CLAW_JUDGE_PROVIDER=openrouter  CLAW_JUDGE_MODEL=<model id>  CLAW_JUDGE_API_KEY_NAME=OPENROUTER_API_KEY
CLAW_JUDGE_PROVIDER=
CLAW_JUDGE_MODEL=
CLAW_JUDGE_API_KEY_NAME=
CLAW_JUDGE_API_KEY=

# GitHub token (a read-only fine-grained token is enough). Gives scouts better repo data and higher rate limits.
GH_TOKEN=

# Linux VM size. Defaults suit a 48 GB Mac.
CLAW_CPUS=6
CLAW_MEMORY_GIB=24
CLAW_DISK_GIB=200

# ── Linux cloud product (./product/claw) ─────────────────────────────────────
# Observe and guards do not need TypeSafe. Live Jev policy does. Never paste keys in chat.
# TYPESAFE_API_KEY=
# TEXT_MODEL_API_KEY=
# BU_CDP_URL=
# CLAW_BROWSER_PROFILE=
# CLAW_WORKSPACE=
# CLAW_ALLOW_IRREVERSIBLE=0
