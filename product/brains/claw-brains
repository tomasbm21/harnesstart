#!/usr/bin/env bash
# Norfront Claw — optional Linux-cloud brains (OpenHands, OpenClaw, Goose).
# Prime Agent stays the default brain in product/claw.
# Run from anywhere: ./product/brains/claw-brains doctor
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
export CLAW_REPO="${CLAW_REPO:-$ROOT}"
export PATH="$HOME/.local/bin:$PATH"
# OpenClaw's npm global binary lives under nvm; Node 22 on this image is too old.
NVM_ROOT="${NVM_DIR:-$HOME/.nvm}/versions/node"
if [ -d "$NVM_ROOT" ]; then
  NVM_LATEST="$(ls -d "$NVM_ROOT"/v*/bin 2>/dev/null | sort -V | tail -1 || true)"
  if [ -n "${NVM_LATEST:-}" ]; then
    export PATH="$NVM_LATEST:$PATH"
  fi
fi
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m claw_brains "$@"
