# Optional brains (product/brains). Copy ideas into repo-root claw.env — that file is gitignored.
# This file is documentation only. Do not put real keys here. Never paste keys in chat.

# Default brain is Prime Agent (product/claw). This package does not take it over.
# CLAW_BRAIN=prime          # prime | openhands | openclaw | goose
# CLAW_MODEL=deepseek-v4-pro
# CLAW_PROVIDER=deepseek
# CLAW_WORKSPACE=$HOME/.local/share/norfront-claw/workspace
# CLAW_BRAINS_HOME=$HOME/.local/share/norfront-claw/brains

# Binary overrides (optional)
# CLAW_PRIME_BIN=prime-agent
# CLAW_OPENHANDS_BIN=openhands
# CLAW_OPENCLAW_BIN=openclaw
# CLAW_GOOSE_BIN=goose

# Live model turns (set in claw.env locally, never in chat)
# DEEPSEEK_API_KEY=
# LLM_API_KEY=              # OpenHands; blank reuses DEEPSEEK_API_KEY in the child env
# OPENAI_API_KEY=           # Goose OpenAI-compatible fallback; blank reuses DEEPSEEK
# GOOSE_PROVIDER=deepseek
# GOOSE_MODEL=deepseek-v4-pro
# GOOSE_DISABLE_KEYRING=1   # headless Linux; this adapter sets it for goose run
# LLM_MODEL=deepseek/deepseek-v4-pro
# LLM_BASE_URL=https://api.deepseek.com
