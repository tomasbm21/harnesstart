# Product env (optional). Copied ideas go in repo-root claw.env — that file is gitignored.
# This file is documentation only. Do not put real keys here.

# Prime Agent (brain)
# CLAW_PROVIDER=deepseek
# CLAW_MODEL=deepseek-v4-pro
# CLAW_PRIME_BIN=prime-agent
# CLAW_WORKSPACE=$HOME/.local/share/norfront-claw/workspace
# CLAW_ALLOW_IRREVERSIBLE=0

# Jev Ultrafast (browser plugin — product/jev, sibling-owned)
# Observe and guards do NOT need TypeSafe.
# TYPESAFE_API_KEY=          # live policy only; set in claw.env, never in chat
# TEXT_MODEL_API_KEY=        # optional; blank reuses DEEPSEEK_API_KEY for the text helper
# BU_CDP_URL=                # e.g. http://127.0.0.1:9222
# CLAW_BROWSER_PROFILE=$HOME/.local/share/norfront-claw/chrome-profile
# CLAW_CHROME_NO_SANDBOX=1   # default on this Linux product
# Interactive TTY prompts (./product/claw doctor / run / choose / browse)
# CLAW_NO_KEY_PROMPT=1
# CLAW_BROWSER_ADAPTER=      # override: module:factory
