# Computer selection. Values never printed. Do not paste keys into chat.
#
# CLAW_VM_BACKEND=qemu
# CLAW_VM_BACKEND=firecracker
# CLAW_VM_BACKEND=celesto
# CLAW_VM_BACKEND=e2b
# CLAW_VM_BACKEND=agentenv
# CLAW_VM_BACKEND=microsandbox
# CLAW_VM_BACKEND=libkrun
#
# CLAW_VM_HOME=/path/to/state
# CLAW_VM_VMM=qemu
#
# Optional hosted keys are NOT required (BRIEF R4). If they exist in the
# environment, claw-vm reports only set/missing and never prints values.
# CELESTO_API_KEY=
# E2B_API_KEY=
# AENV_API_KEY=
